# UniNet cross-platform test image.
#
# Debian + the .NET SDK, so one container can build and run all three language
# bindings against the same native library. Debian does not package Zyre, so it
# is built from source here, which doubles as a test of the path UniNet takes
# on any machine without a system Zyre.
#
#   docker build -f tests/docker/Dockerfile.linux -t uninet-test .
#   docker run --rm --dns 8.8.8.8 -v "$PWD":/src:ro uninet-test
FROM mcr.microsoft.com/dotnet/sdk:8.0

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        build-essential cmake pkg-config git ca-certificates \
        zlib1g-dev liblz4-dev libsodium-dev \
        python3 python3-dev python3-pip python3-pytest pybind11-dev \
    && rm -rf /var/lib/apt/lists/*

# libzmq -> czmq -> zyre, pinned to the versions UniNet's CMake fallback uses.
WORKDIR /deps
RUN git clone --depth 1 -b v4.3.5 https://github.com/zeromq/libzmq.git \
 && cmake -S libzmq -B libzmq/b -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTS=OFF \
          -DWITH_PERF_TOOL=OFF -DWITH_DOC=OFF \
 && cmake --build libzmq/b -j"$(nproc)" && cmake --install libzmq/b \
 && git clone --depth 1 -b v4.2.1 https://github.com/zeromq/czmq.git \
 && cmake -S czmq -B czmq/b -DCMAKE_BUILD_TYPE=Release -DCZMQ_BUILD_SHARED=ON \
          -DBUILD_TESTING=OFF \
 && cmake --build czmq/b -j"$(nproc)" && cmake --install czmq/b \
 && git clone --depth 1 -b v2.0.1 https://github.com/zeromq/zyre.git \
 && cmake -S zyre -B zyre/b -DCMAKE_BUILD_TYPE=Release -DZYRE_BUILD_SHARED=ON \
          -DBUILD_TESTING=OFF \
 && cmake --build zyre/b -j"$(nproc)" && cmake --install zyre/b \
 && ldconfig && rm -rf /deps

COPY tests/docker/run-tests.sh /usr/local/bin/run-tests
RUN chmod +x /usr/local/bin/run-tests
ENTRYPOINT ["/usr/local/bin/run-tests"]
