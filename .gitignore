*.a
bin/
# Every build tree: build/, build-android/, build-slicer/, build2/ ... Git has no
# trailing comments, so "build-cache/  # vcpkg clone" was a literal pattern that
# matched nothing, and build2/ and build3/ matched none of the old rules at all
# and ended up committed.
build*/
.cache/
.cmake/
compile_commands.json
DCMAKE_BUILD*/
dist/
*.dll
*.dylib
*.egg-info/
*.exp
.idea/
*.lib
*.o
*.obj
obj/
out/
*.pyc
__pycache__/
# UniNetSlicer.py stamps the build's git commit into this file before building
# a wheel, and removes it afterwards. Never commit it.
python/uninet/_buildinfo.py
.pytest_cache/
received/
*.so
uninet_bench_log.csv
uninet_network_bench.csv
uninet_profile.txt
.vscode/
wheelhouse/
examples/android/build/
examples/android/.debug.keystore
