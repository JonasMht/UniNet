*.a
bin/
# Every build tree: build/, build-android/, build-slicer/, build2/ ... Git has no
# trailing comments, so "build-cache/  # vcpkg clone" was a literal pattern that
# matched nothing, and build2/ and build3/ matched none of the old rules at all
# and ended up committed.
build*/
.cache/
.cmake/
compile_commands.json
DCMAKE_BUILD*/
dist/
*.dll
*.dylib
*.egg-info/
*.exp
.idea/
*.lib
*.o
*.obj
obj/
out/
*.pyc
__pycache__/
# Do NOT ignore python/uninet/_buildinfo.py: it is written before a wheel is
# built and deleted right after, but scikit-build-core honors .gitignore and
# would silently strip an ignored "generated" file from the wheel - and the
# whole point of the file is to live inside the distributed wheel.
.pytest_cache/
received/
*.so
uninet_bench_log.csv
uninet_network_bench.csv
uninet_profile.txt
.vscode/
wheelhouse/
examples/android/build/
examples/android/.debug.keystore
