<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>UniNet</AssemblyName>
    <RootNamespace>UniNet</RootNamespace>
    <PackageId>UniNet</PackageId>
    <Version>0.1.0</Version>
    <Authors>JonasMht</Authors>
    <Description>UniNet — Unified Networking transport. C# bindings (P/Invoke) to the compiled C++ core.</Description>
    <PackageTags>networking;pubsub;cbor;nats;transport;unity</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
