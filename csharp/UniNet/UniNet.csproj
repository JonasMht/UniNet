<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>UniNet</AssemblyName>
    <RootNamespace>UniNet</RootNamespace>
    <PackageId>UniNet</PackageId>
    <Version>0.2.0</Version>
    <Authors>JonasMht</Authors>
    <Description>UniNet: brokerless peer-to-peer messaging with LAN discovery built in. C# bindings to the compiled C++ core.</Description>
    <PackageTags>networking;pubsub;cbor;json;zeromq;zyre;discovery;unity</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
