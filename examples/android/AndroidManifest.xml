<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="org.uninet.demo">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Not optional for Wi-Fi discovery. Without it Android's Wi-Fi driver
         filters multicast and subnet broadcast in hardware, so the ZRE beacon
         never reaches the app: nothing is ever discovered, and no error is
         raised anywhere. It is a normal install-time permission. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:label="UniNet Demo"
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="true">
        <activity
            android:name="org.uninet.demo.MainActivity"
            android:exported="true"
            android:label="UniNet Demo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
